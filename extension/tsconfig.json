{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM"],

    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,

    "declaration": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,

    // The conversion lives at <repo>/src/matlabify.js so plain `node --test`
    // can exercise it without a build. Pulling it in from here means rootDir
    // has to sit at the repo root, which is why the emitted entry point is
    // lib/extension/src/index.js rather than lib/index.js.
    "allowJs": true,
    "checkJs": false,
    "rootDir": "..",
    "outDir": "lib"
  },
  "include": ["src/**/*", "../src/matlabify.mjs"]
}
